{
  "name": "opssim-africa",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Hands-on operations training for African retail and logistics teams.",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs --production",
    "test": "tsx --test tests/*.test.mjs tests/*.test.ts",
    "test:e2e": "playwright test",
    "backup": "node scripts/backup.mjs",
    "format": "prettier --write src server scripts tests *.json *.ts *.md index.html",
    "format:check": "prettier --check src server scripts tests *.json *.ts *.md index.html",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.174.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "iwer": "^2.8.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vite": "^6.2.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
